        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"Fournisseur\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Nom du fournisseur. null si absent.\"\n    },\n    \"Numero_Facture\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Numéro de facture. null si absent.\"\n    },\n    \"Date\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Date de facture au format YYYY-MM-DD. null si absente ou ambiguë.\"\n    },\n    \"Montant_HT\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"Montant total hors taxes. null si absent.\"\n    },\n    \"TVA\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"Montant monétaire total de TVA, pas le pourcentage. null si absent.\"\n    },\n    \"Total_TTC\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"Montant total toutes taxes comprises. null si absent.\"\n    },\n    \"Devise\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Code de devise indiqué, par exemple MAD ou EUR. Ne pas deviner.\"\n    }\n  },\n  \"required\": [\n    \"Fournisseur\",\n    \"Numero_Facture\",\n    \"Date\",\n    \"Montant_HT\",\n    \"TVA\",\n    \"Total_TTC\",\n    \"Devise\"\n  ],\n  \"additionalProperties\": false\n}",
        "options": {}
      },
